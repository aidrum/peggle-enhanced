<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>Peggle.Android</RootNamespace>
    <AssemblyName>PeggleClassic</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationId>com.aidrum.peggle.hd</ApplicationId>
    <ApplicationTitle>Peggle HD</ApplicationTitle>
    <!-- The activity and its launcher icon aliases (App Icon page) are declared in this template. -->
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
  </PropertyGroup>
  <!-- The iPhone edition is a separate app, so both can be installed side by side. -->
  <PropertyGroup Condition="'$(PeggleEdition)' == 'iPhone'">
    <ApplicationId>com.aidrum.peggle</ApplicationId>
    <ApplicationTitle>Peggle</ApplicationTitle>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>1.1</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- Already-compressed game data (png/ogg) gains nothing from zip compression in the APK. -->
    <AndroidStoreUncompressedFileExtensions>.png;.jpg;.ogg</AndroidStoreUncompressedFileExtensions>
    <!-- Local toolchain: JDK 21 (.NET Android supports 17/21) and the Android Studio SDK. -->
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' And Exists('C:\Program Files\Java\jdk-21')">C:\Program Files\Java\jdk-21</JavaSdkDirectory>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' And Exists('$(LOCALAPPDATA)\Android\Sdk')">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
  </PropertyGroup>
  <!-- Release: compile everything ahead of time (Debug runs managed code slowly, e.g. the image
       loading loops). AOT requires trimming; partial mode plus the roots below keeps the game's own
       assemblies whole and only trims framework libraries marked trimmable. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <TrimmerRootAssembly Include="PeggleClassic" RootMode="All" />
    <TrimmerRootAssembly Include="PeggleGame" RootMode="All" />
    <TrimmerRootAssembly Include="SexyFramework" RootMode="All" />
    <TrimmerRootAssembly Include="MonoGame.Framework" RootMode="All" />
    <TrimmerRootAssembly Include="NVorbis" RootMode="All" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Peggle\Peggle.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Launcher icons for the edition (tools/convert_icons.py); the adaptive icon XML in
         Resources/mipmap-anydpi-v26 is shared. -->
    <AndroidResource Include="Icons\$(PeggleEdition)\**\*.png" Link="Resources\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Remove="Icons\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Converted game assets, read in place from the APK (see ApkContentSource). -->
    <AndroidAsset Include="..\Peggle\Content.Shared\**\*" Link="Content\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\Peggle\Content.$(PeggleEdition)\**\*" Link="Content\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
